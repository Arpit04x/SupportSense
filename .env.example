# ==========================================
# SupportSense Environment Variables
# ==========================================

# --- AI Service (Python FastAPI) ---
# Google Gemini API Key (recommended - free tier at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude API Key (optional alternative)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Active LLM Provider: gemini | anthropic (auto-detected if blank)
LLM_PROVIDER=gemini

# LLM Model (e.g. gemini-1.5-flash, gemini-2.0-flash, claude-3-haiku-20240307)
LLM_MODEL=gemini-1.5-flash

# Confidence threshold below which tickets are marked needs_human = true (0.0 to 1.0)
CONFIDENCE_THRESHOLD=0.6

# ChromaDB persistence directory
CHROMA_PERSIST_DIR=./data/chroma_db

# Knowledge Base documents directory
DOCS_DIR=./data/docs

# AI service server port
AI_SERVICE_PORT=8000

# --- Backend (Node.js + Express) ---
# Node backend server port
PORT=3000

# URL of the Python AI service
AI_SERVICE_URL=http://localhost:8000

# Path to the SQLite database file
DATABASE_PATH=./data/support_sense.db
